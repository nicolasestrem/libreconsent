{
  "name": "libreconsent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node scripts/run-vitest.mjs run",
    "build": "pnpm -r --if-present build",
    "size": "size-limit",
    "examples:serve": "node scripts/serve-examples.mjs",
    "e2e": "playwright test --project=e2e",
    "a11y": "playwright test --project=a11y",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm size && pnpm e2e && pnpm a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@size-limit/file": "13.0.1",
    "@types/node": "26.1.1",
    "jsdom": "29.1.1",
    "size-limit": "13.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
