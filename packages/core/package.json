{
  "name": "@libreconsent/core",
  "version": "1.0.0",
  "description": "Core state and consent infrastructure for libreconsent.",
  "license": "MIT",
  "author": "Nicolas Estrem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasestrem/libreconsent.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nicolasestrem/libreconsent#readme",
  "bugs": {
    "url": "https://github.com/nicolasestrem/libreconsent/issues"
  },
  "keywords": [
    "consent",
    "consent-management",
    "consent-mode",
    "cookie-consent",
    "privacy",
    "gdpr",
    "ccpa",
    "gpc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.global.js",
    "dist/index.global.js.map",
    "dist/head-snippet.js",
    "dist/head-snippet.js.map",
    "dist/head-snippet.d.ts",
    "dist/head-snippet.global.js",
    "dist/head-snippet.global.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "test": "node ../../scripts/run-vitest.mjs run --root ../.. packages/core/src"
  }
}
