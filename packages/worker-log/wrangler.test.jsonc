// SPDX-License-Identifier: MIT
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "libreconsent-worker-log-test-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://app.example.test",
    "AUDIT_BEARER_TOKEN": "local-test-bearer-token",
    "RETENTION_DAYS": "395"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libreconsent-worker-log-test-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RECEIPT_RATE_LIMITER",
      "namespace_id": "9001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": false
  }
}
